---
import { Image } from "astro:assets";

import teamImage from "../assets/images/hero-stg-team.jpg";
import { siteIdentity } from "../data/site";
---

<section class="team-manifesto" id="team" data-team aria-labelledby="team-title">
  <div class="team-manifesto__stage">
    <figure class="team-manifesto__photo">
      <Image
        src={teamImage}
        alt="屋外で並ぶ複数名の人物"
        widths={[640, 960, 1280, 1600]}
        sizes="100vw"
        format="webp"
        quality={86}
        loading="lazy"
      />
    </figure>
    <div class="team-manifesto__shade" aria-hidden="true"></div>

    <div class="team-manifesto__index" aria-hidden="true">
      <span>04 / THE PEOPLE</span>
      <span>SAWADA TOMU GROUP</span>
    </div>

    <div class="team-manifesto__copy">
      <p>{siteIdentity.tagline}</p>
      <h2 id="team-title">どんな夢も<br />叶えていく</h2>
      <span>{siteIdentity.name}</span>
    </div>

    <p class="team-manifesto__hold" aria-hidden="true">HOLD THE FRAME</p>
  </div>
</section>

<style>
  .team-manifesto {
    --team-inset-y: 36%;
    --team-inset-x: 31%;
    --team-photo-scale: 1.1;
    --team-copy-opacity: 0;
    position: relative;
    height: 185svh;
    color: white;
    background: var(--ink);
  }

  .team-manifesto__stage {
    position: sticky;
    top: 0;
    height: 100svh;
    min-height: 42rem;
    overflow: hidden;
    background: var(--ink);
  }

  .team-manifesto__photo,
  .team-manifesto__shade {
    position: absolute;
    inset: 0;
    margin: 0;
  }

  .team-manifesto__photo {
    clip-path: inset(var(--team-inset-y) var(--team-inset-x));
    will-change: clip-path;
  }

  .team-manifesto__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 58%;
    filter: saturate(0.82) contrast(1.02);
    transform: scale(var(--team-photo-scale));
    will-change: transform;
  }

  .team-manifesto__shade {
    background:
      linear-gradient(180deg, rgb(4 8 6 / 0.58), transparent 34%, transparent 55%, rgb(4 8 6 / 0.76)),
      linear-gradient(90deg, rgb(4 8 6 / 0.48), transparent 55%);
    pointer-events: none;
  }

  .team-manifesto__index {
    position: absolute;
    top: calc(var(--site-header-height) + 1.2rem);
    right: var(--page-pad);
    left: var(--page-pad);
    display: flex;
    justify-content: space-between;
    color: rgb(255 255 255 / 0.7);
    font: 700 0.62rem/1 var(--font-mono);
    letter-spacing: 0.13em;
  }

  .team-manifesto__copy {
    position: absolute;
    right: var(--page-pad);
    bottom: clamp(3rem, 8vh, 6rem);
    left: var(--page-pad);
    opacity: var(--team-copy-opacity);
    transform: translateY(calc((1 - var(--team-copy-opacity)) * 1.5rem));
    will-change: opacity, transform;
  }

  .team-manifesto__copy p {
    margin: 0 0 1.5rem;
    color: var(--brass-light);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.16em;
  }

  .team-manifesto__copy h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(4.2rem, 11vw, 12rem);
    font-weight: 500;
    line-height: 0.92;
    letter-spacing: -0.075em;
  }

  .team-manifesto__copy > span {
    display: block;
    margin-top: 2rem;
    color: rgb(255 255 255 / 0.68);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
  }

  .team-manifesto__hold {
    position: absolute;
    right: 1.2rem;
    top: 50%;
    margin: 0;
    color: rgb(255 255 255 / 0.46);
    font: 700 0.55rem/1 var(--font-condensed);
    letter-spacing: 0.2em;
    writing-mode: vertical-rl;
  }

  @media (max-width: 720px) {
    .team-manifesto {
      height: 148svh;
    }

    .team-manifesto__stage {
      min-height: 38rem;
    }

    .team-manifesto__photo :global(img) {
      object-position: 50% center;
    }

    .team-manifesto__copy h2 {
      font-size: clamp(3.6rem, 16vw, 4.4rem);
    }

    .team-manifesto__index span:last-child,
    .team-manifesto__hold {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .team-manifesto {
      --team-inset-y: 0%;
      --team-inset-x: 0%;
      --team-photo-scale: 1;
      --team-copy-opacity: 1;
      height: auto;
    }

    .team-manifesto__stage {
      position: relative;
      height: 100svh;
    }

    .team-manifesto__photo,
    .team-manifesto__photo :global(img),
    .team-manifesto__copy {
      will-change: auto;
    }
  }

  :global(html.is-forced-reduced-motion) .team-manifesto {
    --team-inset-y: 0%;
    --team-inset-x: 0%;
    --team-photo-scale: 1;
    --team-copy-opacity: 1;
    height: auto;
  }

  :global(html.is-forced-reduced-motion) .team-manifesto__stage {
    position: relative;
    height: 100svh;
  }

  :global(html.is-forced-reduced-motion) .team-manifesto__photo,
  :global(html.is-forced-reduced-motion) .team-manifesto__photo :global(img),
  :global(html.is-forced-reduced-motion) .team-manifesto__copy {
    will-change: auto;
  }
</style>
