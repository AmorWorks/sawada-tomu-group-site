---
import { Image } from "astro:assets";

import exteriorImage from "../assets/images/hero-exterior-work.jpg";
import grassImage from "../assets/images/hero-grass-maintenance.jpg";
import pruningImage from "../assets/images/hero-pruning.jpg";
import { processSteps } from "../data/site";

const chapters = [
  {
    number: "01",
    cue: "LOOK",
    titleLead: "まず、",
    titleTail: "現場を見る。",
    copy: "作業に入る前に、状態と周囲を確認する。必要な仕事を見極め、相談内容を整理します。",
    image: grassImage,
    alt: "河川沿いの草地で作業する人物",
  },
  {
    number: "02",
    cue: "PLAN",
    titleLead: "段取りを、",
    titleTail: "曖昧にしない。",
    copy: "作業の範囲と進め方を揃えてから、現場に入る。確認を重ね、仕事を一つずつ組み立てます。",
    image: pruningImage,
    alt: "庭木の枝を手入れする人物",
  },
  {
    number: "03",
    cue: "FINISH",
    titleLead: "最後まで、",
    titleTail: "仕事にする。",
    copy: "作業後の確認と片付けまで、一つの仕事として向き合う。次へつながる状態を目指します。",
    image: exteriorImage,
    alt: "屋外工事を進める複数の人物",
  },
] as const;
---

<section class="journey" id="work" aria-labelledby="journey-title" data-journey>
  <div class="section-kicker">
    <span>03 / HOW WE WORK</span>
    <span>仕事の進め方</span>
  </div>

  <header class="journey__head">
    <p class="eyebrow">ONE CONTINUOUS WORK</p>
    <h2 id="journey-title">見る。<br />組む。<br />仕上げる。</h2>
    <p>
      作業そのものだけでなく、前後の確認まで。<br />
      一つの現場を、一つの仕事として進めます。
    </p>
  </header>

  <div class="journey__chapters">
    {chapters.map((chapter, index) => (
      <article class:list={["journey__chapter", index % 2 === 1 && "is-reverse"]} data-journey-step>
        <figure class="journey__media">
          <Image
            src={chapter.image}
            alt={chapter.alt}
            widths={[640, 960, 1280, 1600]}
            sizes="(max-width: 820px) 100vw, 62vw"
            format="webp"
            quality={84}
            loading="lazy"
          />
          <figcaption>{chapter.number} / 03 · {chapter.cue}</figcaption>
        </figure>

        <div class="journey__copy">
          <div class="journey__marker" aria-hidden="true"><i></i><span>{chapter.number}</span></div>
          <p>{chapter.cue}</p>
          <h3>{chapter.titleLead}<br />{chapter.titleTail}</h3>
          <p>{chapter.copy}</p>
        </div>
      </article>
    ))}
  </div>

  <div class="journey__process" id="process" aria-labelledby="process-title">
    <div class="journey__process-head">
      <p class="eyebrow">PROCESS</p>
      <h3 id="process-title">ご相談から、完了確認まで。</h3>
    </div>
    <ol>
      {processSteps.map((step) => (
        <li>
          <span>{step.number}</span>
          <strong>{step.title}</strong>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .journey {
    color: white;
    background: var(--ink);
  }

  .journey__head {
    position: relative;
    display: grid;
    grid-template-columns: minmax(18rem, 0.65fr) minmax(20rem, 0.35fr);
    grid-template-rows: auto 1fr;
    gap: 2rem clamp(3rem, 9vw, 11rem);
    min-height: 76svh;
    padding: clamp(4rem, 9vw, 8rem) var(--page-pad);
    align-content: center;
    overflow: hidden;
  }

  .journey__head::after {
    content: "STG";
    position: absolute;
    right: -0.08em;
    bottom: -0.24em;
    color: rgb(255 255 255 / 0.035);
    font: 800 min(43vw, 38rem)/0.8 var(--font-condensed);
    letter-spacing: -0.1em;
    pointer-events: none;
  }

  .journey__head .eyebrow {
    grid-column: 1 / -1;
    color: var(--brass-light);
  }

  .journey__head h2 {
    position: relative;
    z-index: 1;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(4rem, 9vw, 9.5rem);
    font-weight: 500;
    line-height: 0.92;
    letter-spacing: -0.075em;
  }

  .journey__head > p:last-child {
    position: relative;
    z-index: 1;
    align-self: end;
    margin: 0;
    color: var(--muted-on-dark);
    line-height: 2.1;
  }

  .journey__chapters {
    border-top: 1px solid var(--line-light);
  }

  .journey__chapter {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(20rem, 0.7fr);
    min-height: 82svh;
    border-bottom: 1px solid var(--line-light);
  }

  .journey__chapter.is-reverse {
    grid-template-columns: minmax(20rem, 0.7fr) minmax(0, 1.3fr);
  }

  .journey__chapter.is-reverse .journey__media {
    order: 2;
  }

  .journey__media {
    position: relative;
    min-height: 38rem;
    margin: 0;
    overflow: hidden;
    background: var(--green-deep);
  }

  .experience-ready .journey__media {
    clip-path: inset(8% 6%);
    transition: clip-path 1.1s var(--ease-out);
  }

  .experience-ready .journey__chapter.is-visible .journey__media {
    clip-path: inset(0);
  }

  .journey__media::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 58%, rgb(4 8 6 / 0.6));
  }

  .journey__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.78);
    transform: scale(1.035);
    transition: transform 1.2s var(--ease-out), filter 1.2s ease;
  }

  .journey__chapter.is-visible .journey__media :global(img) {
    filter: saturate(0.92);
    transform: scale(1);
  }

  .journey__media figcaption {
    position: absolute;
    z-index: 1;
    right: 1.5rem;
    bottom: 1.5rem;
    left: 1.5rem;
    color: rgb(255 255 255 / 0.74);
    font: 700 0.62rem/1 var(--font-mono);
    letter-spacing: 0.13em;
  }

  .journey__copy {
    position: relative;
    display: flex;
    padding: clamp(2.5rem, 6vw, 6rem);
    border-left: 1px solid var(--line-light);
    flex-direction: column;
    justify-content: center;
  }

  .is-reverse .journey__copy {
    border-right: 1px solid var(--line-light);
    border-left: 0;
  }

  .journey__copy > p:nth-of-type(1) {
    margin: 0;
    color: var(--brass-light);
    font: 700 0.66rem/1 var(--font-condensed);
    letter-spacing: 0.2em;
  }

  .journey__copy h3 {
    max-width: none;
    margin: clamp(3rem, 8vh, 6rem) 0 2rem;
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 3.2vw, 4.5rem);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -0.055em;
  }

  .journey__copy > p:last-child {
    max-width: 30rem;
    margin: 0;
    color: var(--muted-on-dark);
    line-height: 2;
  }

  .journey__marker {
    position: absolute;
    top: 2.2rem;
    right: clamp(2rem, 4vw, 4rem);
    bottom: 2.2rem;
    display: grid;
    grid-template-rows: 1fr auto;
    gap: 1rem;
    color: rgb(255 255 255 / 0.3);
    font: 700 0.63rem/1 var(--font-mono);
  }

  .journey__marker i {
    width: 1px;
    height: 100%;
    background: rgb(255 255 255 / 0.14);
  }

  .journey__marker i::after {
    content: "";
    display: block;
    width: 1px;
    height: 100%;
    background: var(--brass-light);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 1.1s var(--ease-out) 120ms;
  }

  .journey__chapter.is-visible .journey__marker i::after {
    transform: scaleY(1);
  }

  .journey__process {
    display: grid;
    grid-template-columns: minmax(18rem, 0.55fr) minmax(0, 1.45fr);
    gap: clamp(3rem, 7vw, 8rem);
    padding: clamp(4rem, 8vw, 7rem) var(--page-pad);
    background: var(--green-deep);
  }

  .journey__process-head h3 {
    margin: 1.5rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(2.3rem, 4vw, 4.8rem);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.04em;
  }

  .journey__process .eyebrow {
    color: var(--brass-light);
  }

  .journey__process ol {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line-light);
    list-style: none;
  }

  .journey__process li {
    position: relative;
    display: grid;
    min-height: 11rem;
    padding: 1.5rem 1rem;
    border-right: 1px solid var(--line-light);
    align-content: space-between;
  }

  .journey__process li::before {
    content: "";
    position: absolute;
    top: -4px;
    left: -4px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--brass-light);
  }

  .journey__process li span {
    color: var(--brass-light);
    font: 700 0.62rem/1 var(--font-mono);
  }

  .journey__process li strong {
    font-size: 0.82rem;
    line-height: 1.6;
  }

  @media (max-width: 840px) {
    .journey__head,
    .journey__chapter,
    .journey__chapter.is-reverse,
    .journey__process {
      grid-template-columns: 1fr;
    }

    .journey__head {
      min-height: 0;
      gap: 2.5rem;
    }

    .journey__head h2 {
      font-size: clamp(4.5rem, 19vw, 7rem);
    }

    .journey__chapter,
    .journey__chapter.is-reverse {
      min-height: 0;
    }

    .journey__chapter.is-reverse .journey__media {
      order: 0;
    }

    .journey__media {
      min-height: 0;
      aspect-ratio: 16 / 10;
    }

    .journey__copy,
    .is-reverse .journey__copy {
      min-height: 24rem;
      padding: 3rem var(--page-pad) 4rem;
      border: 0;
      border-top: 1px solid var(--line-light);
    }

    .journey__copy h3 {
      width: 100%;
      max-width: 100%;
      margin-top: 3rem;
      font-size: clamp(2.4rem, 10vw, 3.2rem);
    }

    .journey__process {
      gap: 3rem;
    }
  }

  @media (max-width: 620px) {
    .journey__head > p:last-child br {
      display: none;
    }

    .journey__process ol {
      grid-template-columns: 1fr;
    }

    .journey__process li {
      grid-template-columns: 2.5rem 1fr;
      min-height: 0;
      padding: 1.25rem 0;
      border-right: 0;
      border-bottom: 1px solid var(--line-light);
      align-items: center;
      align-content: initial;
    }

    .journey__process li::before {
      top: auto;
      left: -3px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .experience-ready .journey__media,
    .journey__media :global(img) {
      clip-path: none;
      filter: none;
      transform: none;
    }

    .journey__marker i::after {
      transform: scaleY(1);
    }
  }

  :global(html.is-forced-reduced-motion.experience-ready) .journey__media,
  :global(html.is-forced-reduced-motion) .journey__media :global(img) {
    clip-path: none;
    filter: none;
    transform: none;
  }

  :global(html.is-forced-reduced-motion) .journey__marker i::after {
    transform: scaleY(1);
  }
</style>
