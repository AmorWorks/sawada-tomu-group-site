---
import { Image } from "astro:assets";

import heroImage from "../assets/images/hero-tree-removal.jpg";
import { siteIdentity } from "../data/site";
---

<section class="entry" id="top" data-entry aria-labelledby="entry-title">
  <div class="entry__stage">
    <figure class="entry__media">
      <Image
        src={heroImage}
        alt="屋外で樹木の作業を進める人物"
        widths={[640, 960, 1280, 1600]}
        sizes="100vw"
        format="webp"
        quality={86}
        loading="eager"
        fetchpriority="high"
      />
    </figure>
    <div class="entry__wash" aria-hidden="true"></div>
    <div class="entry__grid" aria-hidden="true"><i></i><i></i><i></i></div>

    <div class="entry__coordinate" aria-hidden="true">
      <span>FIELD / 01</span>
      <span>SITE WORK / EXTERIOR CARE</span>
    </div>

    <div class="entry__content">
      <p class="entry__company">{siteIdentity.englishName} <span>{siteIdentity.name}</span></p>
      <h1 id="entry-title">あなたを<br />笑顔にする会社</h1>
      <p class="entry__lead">
        伐採・抜根、草刈り・年間管理、剪定、外構工事。<br />
        STGは、現場と人に向き合います。
      </p>
      <div class="entry__actions">
        <a href="#services">業務内容を見る <span aria-hidden="true">↓</span></a>
        <a href="#contact">仕事の相談へ <span aria-hidden="true">↘</span></a>
      </div>
    </div>

    <div class="entry__scope" aria-label="主な業務">
      <span>伐採・抜根</span>
      <span>草刈り・年間管理</span>
      <span>剪定</span>
      <span>外構工事</span>
    </div>

    <div class="entry__scroll" aria-hidden="true">
      <span>SCROLL</span>
      <i></i>
    </div>
  </div>
</section>

<style>
  .entry {
    position: relative;
    height: 122svh;
    color: white;
    background: var(--ink);
  }

  .entry__stage {
    position: sticky;
    top: 0;
    height: 100svh;
    min-height: 42rem;
    overflow: hidden;
    background: var(--ink);
  }

  .entry__media,
  .entry__wash,
  .entry__grid {
    position: absolute;
    inset: 0;
    margin: 0;
  }

  .entry__media :global(img) {
    width: 100%;
    height: 108%;
    object-fit: cover;
    object-position: 53% 48%;
    filter: saturate(0.82) contrast(1.03);
    transform: translate3d(0, calc(var(--entry-progress, 0) * -4%), 0)
      scale(calc(1.035 + var(--entry-progress, 0) * 0.035));
    transform-origin: center;
    will-change: transform;
  }

  .entry__wash {
    background:
      linear-gradient(90deg, rgb(4 8 6 / 0.82) 0%, rgb(4 8 6 / 0.54) 43%, rgb(4 8 6 / 0.12) 73%),
      linear-gradient(180deg, rgb(3 7 5 / 0.62), transparent 34%, transparent 68%, rgb(3 7 5 / 0.72));
  }

  .entry__grid {
    left: var(--page-pad);
    right: var(--page-pad);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-right: 1px solid rgb(255 255 255 / 0.13);
    border-left: 1px solid rgb(255 255 255 / 0.13);
  }

  .entry__grid i {
    border-right: 1px solid rgb(255 255 255 / 0.13);
  }

  .entry__coordinate {
    position: absolute;
    top: calc(var(--site-header-height) + 1.25rem);
    right: var(--page-pad);
    left: var(--page-pad);
    display: flex;
    justify-content: space-between;
    color: rgb(255 255 255 / 0.7);
    font: 700 0.62rem/1 var(--font-mono);
    letter-spacing: 0.12em;
  }

  .entry__content {
    position: absolute;
    right: var(--page-pad);
    bottom: clamp(8.5rem, 16vh, 12rem);
    left: var(--page-pad);
    max-width: 64rem;
  }

  .entry__company {
    display: flex;
    gap: 1rem;
    align-items: center;
    margin: 0 0 clamp(1.5rem, 3vh, 2.5rem);
    color: var(--brass-light);
    font: 700 0.68rem/1 var(--font-condensed);
    letter-spacing: 0.18em;
  }

  .entry__company span {
    padding-left: 1rem;
    color: rgb(255 255 255 / 0.72);
    border-left: 1px solid rgb(255 255 255 / 0.34);
    font-family: var(--font-body);
    letter-spacing: 0.08em;
  }

  .entry h1 {
    max-width: 9ch;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(4rem, 9.2vw, 9.8rem);
    font-weight: 500;
    line-height: 0.98;
    letter-spacing: -0.065em;
    text-wrap: balance;
  }

  .entry__lead {
    margin: clamp(1.5rem, 3vh, 2.5rem) 0 0;
    color: rgb(255 255 255 / 0.78);
    font-size: clamp(0.9rem, 1.1vw, 1.05rem);
    line-height: 2;
  }

  .entry__actions {
    display: flex;
    gap: 0.75rem;
    margin-top: clamp(1.5rem, 3vh, 2.5rem);
  }

  .entry__actions a {
    display: inline-flex;
    min-width: 12rem;
    min-height: 3.8rem;
    padding: 0 1.15rem;
    color: white;
    border: 1px solid rgb(255 255 255 / 0.5);
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    font-size: 0.74rem;
    font-weight: 700;
    text-decoration: none;
    transition: color 180ms ease, background-color 180ms ease, border-color 180ms ease;
  }

  .entry__actions a:first-child {
    color: var(--ink);
    border-color: var(--paper);
    background: var(--paper);
  }

  .entry__actions a:hover,
  .entry__actions a:focus-visible {
    color: var(--ink);
    border-color: var(--brass-light);
    background: var(--brass-light);
  }

  .entry__scope {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    min-height: 4.8rem;
    border-top: 1px solid rgb(255 255 255 / 0.2);
    background: rgb(4 8 6 / 0.28);
    backdrop-filter: blur(5px);
  }

  .entry__scope span {
    display: flex;
    padding: 0.8rem var(--page-pad);
    border-right: 1px solid rgb(255 255 255 / 0.2);
    align-items: center;
    color: rgb(255 255 255 / 0.76);
    font-size: 0.7rem;
    font-weight: 700;
  }

  .entry__scope span:last-child {
    border-right: 0;
  }

  .entry__scroll {
    position: absolute;
    right: var(--page-pad);
    bottom: 6.35rem;
    display: grid;
    grid-template-columns: auto 3.5rem;
    gap: 0.75rem;
    align-items: center;
    color: rgb(255 255 255 / 0.62);
    font: 700 0.58rem/1 var(--font-condensed);
    letter-spacing: 0.17em;
  }

  .entry__scroll i {
    height: 1px;
    overflow: hidden;
    background: rgb(255 255 255 / 0.26);
  }

  .entry__scroll i::after {
    content: "";
    display: block;
    width: 100%;
    height: 100%;
    background: white;
    animation: entry-line 1.8s ease-in-out infinite;
  }

  @keyframes entry-line {
    0% { transform: translateX(-105%); }
    55%, 100% { transform: translateX(105%); }
  }

  @media (max-width: 760px) {
    .entry {
      height: 108svh;
    }

    .entry__stage {
      min-height: 38rem;
    }

    .entry__media :global(img) {
      object-position: 59% center;
    }

    .entry__wash {
      background:
        linear-gradient(90deg, rgb(4 8 6 / 0.8), rgb(4 8 6 / 0.2) 92%),
        linear-gradient(180deg, rgb(3 7 5 / 0.62), transparent 30%, rgb(3 7 5 / 0.75));
    }

    .entry__grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .entry__grid i:nth-child(3) {
      display: none;
    }

    .entry__coordinate span:last-child,
    .entry__scroll {
      display: none;
    }

    .entry__content {
      bottom: 7.6rem;
    }

    .entry__company {
      display: grid;
      gap: 0.45rem;
    }

    .entry__company span {
      padding: 0;
      border: 0;
    }

    .entry h1 {
      font-size: clamp(3.5rem, 17vw, 5.7rem);
    }

    .entry__lead br {
      display: none;
    }

    .entry__actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }

    .entry__actions a {
      min-width: 0;
      min-height: 3.45rem;
      padding-inline: 0.8rem;
      gap: 0.5rem;
      font-size: 0.66rem;
    }

    .entry__scope {
      grid-template-columns: repeat(2, 1fr);
      min-height: 5.5rem;
    }

    .entry__scope span {
      padding: 0.55rem 1rem;
      border-bottom: 1px solid rgb(255 255 255 / 0.18);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .entry {
      height: 100svh;
    }

    .entry__stage {
      position: relative;
    }

    .entry__media :global(img) {
      transform: none;
    }

    .entry__scroll i::after {
      animation: none;
    }
  }

  :global(html.is-forced-reduced-motion) .entry {
    height: 100svh;
  }

  :global(html.is-forced-reduced-motion) .entry__stage {
    position: relative;
  }

  :global(html.is-forced-reduced-motion) .entry__media :global(img) {
    transform: none;
  }

  :global(html.is-forced-reduced-motion) .entry__scroll i::after {
    animation: none;
  }
</style>
