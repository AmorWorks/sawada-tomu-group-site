---
import { Image } from "astro:assets";
import treeRemoval from "../assets/images/hero-tree-removal.jpg";
import grassMaintenance from "../assets/images/hero-grass-maintenance.jpg";
import exteriorWork from "../assets/images/hero-exterior-work.jpg";

const steps = [
  {
    number: "01",
    label: "READ THE SITE",
    title: "まず、現場を見る。",
    copy: "周囲の状況、作業する範囲、車両や人の動線。手を動かす前に、見るべきものを見ます。",
    image: treeRemoval,
    alt: "伐採作業に向き合う現場の様子"
  },
  {
    number: "02",
    label: "BUILD THE PLAN",
    title: "段取りを、曖昧にしない。",
    copy: "誰が、どの順番で、どこまで進めるか。仕事の流れを整えてから、現場に入ります。",
    image: grassMaintenance,
    alt: "屋外作業を進める現場の様子"
  },
  {
    number: "03",
    label: "FINISH WITH CARE",
    title: "最後まで、仕事にする。",
    copy: "作業だけで終わらせず、挨拶、報告、片付けまで。目立たないところにも人柄は表れます。",
    image: exteriorWork,
    alt: "外構工事に取り組む現場の様子"
  }
];
---

<section class="approach section-shell" id="work" aria-labelledby="approach-title">
  <div class="section-kicker" data-reveal>
    <span>HOW WE WORK</span>
    <span>仕事の精度</span>
  </div>

  <div class="approach-intro" data-reveal>
    <p class="approach-index">01 — 03</p>
    <h2 id="approach-title">目立たない段取りまで、<br />仕事にする。</h2>
    <p>きれいな仕上がりだけでは、信頼は続かない。STGが大切にする、現場との向き合い方です。</p>
  </div>

  <div class="approach-list">
    {steps.map((step, index) => (
      <article class:list={["approach-card", index % 2 === 1 && "is-reverse"]} data-reveal>
        <div class="approach-visual">
          <Image
            src={step.image}
            alt={step.alt}
            widths={[640, 960, 1280]}
            sizes="(max-width: 800px) 100vw, 58vw"
            format="webp"
            loading="lazy"
          />
          <span class="approach-corner" aria-hidden="true">{step.number}</span>
        </div>
        <div class="approach-copy">
          <div class="approach-meta">
            <span>{step.number}</span>
            <span>{step.label}</span>
          </div>
          <h3>{step.title}</h3>
          <p>{step.copy}</p>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .approach {
    background: var(--ink);
    color: var(--paper);
    overflow: clip;
  }

  .approach-intro {
    display: grid;
    grid-template-columns: minmax(5rem, 0.32fr) minmax(17rem, 1.15fr) minmax(16rem, 0.8fr);
    gap: clamp(1.5rem, 4vw, 5rem);
    align-items: end;
    padding: clamp(4rem, 9vw, 8rem) var(--page-pad) clamp(3rem, 7vw, 6rem);
  }

  .approach-index {
    align-self: start;
    color: var(--brass);
    font: 600 0.72rem/1 var(--font-condensed);
    letter-spacing: 0.2em;
  }

  .approach-intro h2 {
    margin: 0;
    font-size: clamp(2.6rem, 6vw, 6.8rem);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.045em;
  }

  .approach-intro > p:last-child {
    margin: 0;
    color: var(--muted-on-dark);
    line-height: 2;
  }

  .approach-list {
    display: grid;
  }

  .approach-card {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(20rem, 0.75fr);
    min-height: min(74rem, 82svh);
    border-top: 1px solid var(--line-dark);
  }

  .approach-card.is-reverse {
    grid-template-columns: minmax(20rem, 0.75fr) minmax(0, 1.45fr);
  }

  .approach-card.is-reverse .approach-visual {
    order: 2;
  }

  .approach-visual {
    position: relative;
    min-height: 34rem;
    overflow: hidden;
  }

  .approach-visual::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 50%, rgb(8 12 11 / 0.45));
    pointer-events: none;
  }

  .approach-visual :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.1s var(--ease-out);
  }

  .approach-card:hover .approach-visual :global(img) {
    transform: scale(1.025);
  }

  .approach-corner {
    position: absolute;
    right: clamp(1rem, 2vw, 2rem);
    bottom: clamp(1rem, 2vw, 2rem);
    z-index: 1;
    color: rgb(255 255 255 / 0.72);
    font: 500 clamp(3.5rem, 8vw, 8rem)/0.8 var(--font-condensed);
    letter-spacing: -0.06em;
  }

  .approach-copy {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: clamp(2.5rem, 6vw, 6.5rem);
    border-left: 1px solid var(--line-dark);
  }

  .is-reverse .approach-copy {
    border-right: 1px solid var(--line-dark);
    border-left: 0;
  }

  .approach-meta {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1.15rem;
    border-bottom: 1px solid var(--line-dark);
    color: var(--brass);
    font: 600 0.68rem/1.2 var(--font-condensed);
    letter-spacing: 0.15em;
  }

  .approach-copy h3 {
    margin: clamp(2rem, 5vw, 5rem) 0 1.5rem;
    font-size: clamp(2rem, 4vw, 4.8rem);
    line-height: 1.12;
    letter-spacing: -0.035em;
  }

  .approach-copy > p {
    margin: 0;
    max-width: 31rem;
    color: var(--muted-on-dark);
    line-height: 2;
  }

  @media (max-width: 880px) {
    .approach-intro {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .approach-index {
      order: -1;
    }

    .approach-card,
    .approach-card.is-reverse {
      grid-template-columns: 1fr;
      min-height: 0;
    }

    .approach-card.is-reverse .approach-visual {
      order: 0;
    }

    .approach-visual {
      min-height: min(72svh, 36rem);
    }

    .approach-copy,
    .is-reverse .approach-copy {
      min-height: 24rem;
      padding: 2rem var(--page-pad) 3.5rem;
      border-right: 0;
      border-left: 0;
      border-top: 1px solid var(--line-dark);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .approach-visual :global(img) {
      transition: none;
    }
  }
</style>
