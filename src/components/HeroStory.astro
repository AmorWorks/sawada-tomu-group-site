---
import { Image } from "astro:assets";

import exteriorImage from "../assets/images/hero-exterior-work.jpg";
import grassImage from "../assets/images/hero-grass-maintenance.jpg";
import pruningImage from "../assets/images/hero-pruning.jpg";
import teamImage from "../assets/images/hero-stg-team.jpg";
import treeImage from "../assets/images/hero-tree-removal.jpg";
import "../styles/hero.css";

interface Props {
  contactHref?: string;
  servicesHref?: string;
  skipTargetId?: string;
}

type HeroFrame = {
  image: ImageMetadata;
  number: string;
  label: string;
  copy: string;
  alt: string;
  positionClass: string;
  isTeam: boolean;
};

const {
  contactHref = "#contact",
  servicesHref = `${import.meta.env.BASE_URL}services`,
  skipTargetId = "after-hero",
} = Astro.props;

const frames: readonly HeroFrame[] = [
  {
    image: treeImage,
    number: "01",
    label: "伐採・抜根",
    copy: "一本ずつ、確かな手順で。",
    alt: "伐採した樹木を安全な手順で処理する作業風景",
    positionClass: "stg-hero__image--tree",
    isTeam: false,
  },
  {
    image: grassImage,
    number: "02",
    label: "草刈り・年間管理",
    copy: "景観を、日々の仕事で整える。",
    alt: "河川敷で草刈り作業を進めるスタッフ",
    positionClass: "stg-hero__image--grass",
    isTeam: false,
  },
  {
    image: pruningImage,
    number: "03",
    label: "剪定",
    copy: "細部まで、誠実に向き合う。",
    alt: "庭木の剪定を分担して進めるスタッフ",
    positionClass: "stg-hero__image--pruning",
    isTeam: false,
  },
  {
    image: exteriorImage,
    number: "04",
    label: "外構工事",
    copy: "暮らしの足元を、丁寧につくる。",
    alt: "住宅の外構工事をチームで進めるスタッフ",
    positionClass: "stg-hero__image--exterior",
    isTeam: false,
  },
  {
    image: teamImage,
    number: "05",
    label: "STGの仲間",
    copy: "",
    alt: "作業車を背に並ぶ株式会社STGのスタッフ",
    positionClass: "stg-hero__image--team",
    isTeam: true,
  },
];
---

<section
  class="stg-hero"
  data-hero-story
  aria-label="株式会社STGの仕事と仲間をたどるファーストビュー"
>
  <div class="stg-hero__stage" data-hero-stage>
    <div class="stg-hero__media">
      {
        frames.map((frame, index) => (
          <figure
            class:list={[
              "stg-hero__frame",
              index === 0 && "is-current",
              frame.isTeam && "stg-hero__frame--team",
            ]}
            data-hero-frame
            data-hero-label={frame.label}
            aria-hidden={index === 0 ? "false" : "true"}
            style={`--frame-opacity:${index === 0 ? 1 : 0};--frame-scale:${frame.isTeam ? 1.12 : 1.07}`}
          >
            <Image
              class:list={["stg-hero__image", frame.positionClass]}
              src={frame.image}
              alt={frame.alt}
              widths={[480, 768, 1024, 1280]}
              sizes="100vw"
              format="webp"
              quality={84}
              loading={index === 0 ? "eager" : "lazy"}
              fetchpriority={index === 0 ? "high" : undefined}
              decoding="async"
            />
            <div class="stg-hero__shade" aria-hidden="true"></div>
            {
              !frame.isTeam && (
                <figcaption class="stg-hero__caption">
                  <span>{frame.number} / 05　{frame.label}</span>
                  <strong>{frame.copy}</strong>
                </figcaption>
              )
            }
          </figure>
        ))
      }
    </div>

    <div class="stg-hero__geometry" aria-hidden="true">
      <i></i>
      <i></i>
      <i></i>
    </div>

    <div class="stg-hero__identity" data-hero-identity>
      <p class="stg-hero__eyebrow">SAWADA TOMU GROUP</p>
      <p class="stg-hero__company">株式会社STG</p>
      <p class="stg-hero__service-line">伐採・抜根、草刈り・年間管理、剪定、外構工事。</p>
    </div>

    <div
      class="stg-hero__progress"
      data-hero-progress
      role="progressbar"
      aria-label="ファーストビューの進行"
      aria-valuemin="1"
      aria-valuemax="5"
      aria-valuenow="1"
      aria-valuetext="伐採・抜根"
    >
      <span data-hero-counter>01</span>
      <i aria-hidden="true"><b></b></i>
      <span>05</span>
    </div>

    <div class="stg-hero__brand" data-hero-brand>
      <p class="stg-hero__eyebrow">PRECISION × HUMANITY</p>
      <h1>あなたを笑顔にする会社</h1>
      <p class="stg-hero__slogan">どんな夢も叶えていく</p>
      <p class="stg-hero__brand-lead">仕事に、人に、誠実に。</p>
      <div class="stg-hero__brand-actions">
        <a class="stg-hero__button stg-hero__button--primary" href={contactHref}>現場のことを相談する</a>
        <a class="stg-hero__button stg-hero__button--quiet" href={servicesHref}>業務内容を見る</a>
      </div>
    </div>

    <div class="stg-hero__access" data-hero-access>
      <a class="stg-hero__button stg-hero__button--primary" href={contactHref}>相談する</a>
      <a class="stg-hero__skip" href={`#${skipTargetId}`} data-hero-skip>
        <span>演出をスキップ</span>
        <i aria-hidden="true"></i>
      </a>
    </div>

    <div class="stg-hero__scroll-cue" data-hero-scroll-cue aria-hidden="true">
      <span>SCROLL TO EXPLORE</span>
      <i></i>
    </div>
  </div>
</section>

<div
  class="stg-hero__end"
  id={skipTargetId}
  data-hero-end
  tabindex="-1"
  aria-label="ファーストビューの次へ"
></div>

<script src="../scripts/hero.ts"></script>
