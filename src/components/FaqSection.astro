---
import { faqs } from "../data/site";

const safeQuestions = new Set([
  "どのような仕事を相談できますか？",
  "現場の写真だけでも相談できますか？",
  "見積りの前に現場確認はありますか？",
  "法人からも相談できますか？",
]);

const selectedFaqs = faqs.filter((faq) => safeQuestions.has(faq.question));
---

<section class="faq-section" id="faq" aria-labelledby="faq-title">
  <div class="faq-inner">
    <header class="faq-heading">
      <p class="faq-kicker">
        <span>06 / FAQ</span>
        <span>04 QUESTIONS</span>
      </p>
      <h2 id="faq-title">相談前によくあるご質問。</h2>
      <p>決まっていないことがあっても大丈夫です。まず確認したい点をまとめました。</p>
    </header>

    <div class="faq-list">
      {
        selectedFaqs.map((faq, index) => (
          <details class="faq-item">
            <summary>
              <span class="faq-number">Q.{String(index + 1).padStart(2, "0")}</span>
              <span class="faq-question">{faq.question}</span>
              <span class="faq-icon" aria-hidden="true" />
            </summary>
            <div class="faq-answer">
              <span aria-hidden="true">A.</span>
              <p>{faq.answer}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq-section {
    color: var(--ink, #111713);
    background: var(--surface, #fbfaf6);
    border-top: 1px solid var(--line, rgb(17 23 19 / 0.14));
    scroll-margin-top: calc(var(--site-header-height, 5rem) + 1rem);
  }

  .faq-inner {
    display: grid;
    grid-template-columns: minmax(17rem, 0.7fr) minmax(0, 1.3fr);
    gap: clamp(3rem, 8vw, 9rem);
    width: min(100%, 90rem);
    margin-inline: auto;
    padding: clamp(5rem, 9vw, 8rem) var(--page-pad, clamp(1.25rem, 4.5vw, 5.5rem));
  }

  .faq-kicker {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin: 0 0 2rem;
    color: var(--brass-dark, #725838);
    font: 700 0.68rem/1 var(--font-condensed, sans-serif);
    letter-spacing: 0.16em;
  }

  .faq-kicker span:last-child {
    color: var(--muted, #68716b);
  }

  .faq-heading h2 {
    max-width: 10em;
    margin: 0;
    font-family: var(--font-display, serif);
    font-size: clamp(2.5rem, 5vw, 5.2rem);
    font-weight: 500;
    letter-spacing: -0.05em;
    line-height: 1.12;
  }

  .faq-heading > p:last-child {
    max-width: 31rem;
    margin: 2.25rem 0 0;
    color: var(--ink-soft, #26332b);
    line-height: 2;
  }

  .faq-list {
    border-top: 1px solid var(--line, rgb(17 23 19 / 0.14));
  }

  .faq-item {
    border-bottom: 1px solid var(--line, rgb(17 23 19 / 0.14));
  }

  .faq-item summary {
    display: grid;
    grid-template-columns: 3.7rem minmax(0, 1fr) 1.25rem;
    gap: 1rem;
    align-items: center;
    min-height: 6.6rem;
    padding-block: 1.25rem;
    cursor: pointer;
    list-style: none;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-number,
  .faq-answer > span {
    color: var(--brass-dark, #725838);
    font: 700 0.68rem/1 var(--font-mono, monospace);
    letter-spacing: 0.1em;
  }

  .faq-question {
    font-family: var(--font-display, serif);
    font-size: clamp(1.05rem, 1.8vw, 1.3rem);
    font-weight: 600;
    line-height: 1.65;
  }

  .faq-icon {
    position: relative;
    width: 1rem;
    height: 1rem;
    justify-self: end;
  }

  .faq-icon::before,
  .faq-icon::after {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 100%;
    height: 1px;
    content: "";
    background: currentColor;
    transform: translate(-50%, -50%);
  }

  .faq-icon::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  .faq-item[open] .faq-icon::after {
    display: none;
  }

  .faq-answer {
    display: grid;
    grid-template-columns: 3.7rem minmax(0, 1fr);
    gap: 1rem;
    padding: 0 0 2rem;
  }

  .faq-answer > span {
    padding-top: 0.45rem;
  }

  .faq-answer p {
    max-width: 44rem;
    margin: 0;
    color: var(--ink-soft, #26332b);
    font-size: 0.94rem;
    line-height: 2;
  }

  .faq-item summary:focus-visible {
    outline: 2px solid var(--accent, #82a75f);
    outline-offset: 4px;
  }

  @media (max-width: 820px) {
    .faq-inner {
      grid-template-columns: 1fr;
      gap: 3.5rem;
      padding-block: 4.5rem 5.5rem;
    }
  }

  @media (max-width: 520px) {
    .faq-item summary {
      grid-template-columns: 3rem minmax(0, 1fr) 1rem;
      gap: 0.65rem;
      min-height: 5.6rem;
    }

    .faq-answer {
      grid-template-columns: 3rem minmax(0, 1fr);
      gap: 0.65rem;
    }
  }
</style>
