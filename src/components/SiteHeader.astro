---
const home = import.meta.env.BASE_URL;

const navItems = [
  { label: "WORK", href: `${home}#services` },
  { label: "ABOUT", href: `${home}#about` },
  { label: "FAQ", href: `${home}#faq` },
  { label: "CONTACT", href: `${home}#contact`, accent: true }
];
---

<header class="site-header" data-site-header>
  <a class="site-brand" href={`${home}#top`} aria-label="株式会社STG ページ上部へ">
    <span class="site-brand__mark" aria-hidden="true">STG</span>
    <span class="site-brand__name">株式会社STG</span>
  </a>

  <nav class="site-nav" aria-label="メインナビゲーション">
    {navItems.map((item) => (
      <a class:list={{ "is-contact": item.accent }} href={item.href}>{item.label}</a>
    ))}
  </nav>

  <button
    class="site-menu-button"
    type="button"
    aria-expanded="false"
    aria-controls="site-menu"
    aria-label="メニューを開く"
    data-menu-button
  >
    <span>MENU</span>
    <span class="site-menu-button__icon" aria-hidden="true"><i></i><i></i></span>
  </button>

  <div class="site-menu" id="site-menu" data-site-menu aria-hidden="true" hidden>
    <nav aria-label="スマートフォンメニュー">
      {navItems.map((item, index) => (
        <a href={item.href}>
          <span aria-hidden="true">0{index + 1}</span>
          <strong>{item.label}</strong>
        </a>
      ))}
    </nav>
    <p><span>SAWADA TOMU GROUP</span><strong>株式会社STG</strong></p>
  </div>
</header>

<script>
  const bindHeader = () => {
    const header = document.querySelector<HTMLElement>("[data-site-header]");
    if (!header || header.dataset.bound === "true") return;
    header.dataset.bound = "true";

    const button = header.querySelector<HTMLButtonElement>("[data-menu-button]");
    const menu = header.querySelector<HTMLElement>("[data-site-menu]");
    const menuLinks = Array.from(menu?.querySelectorAll<HTMLAnchorElement>("a") ?? []);

    if (!button || !menu) return;

    const setOpen = (open: boolean, restoreFocus = false) => {
      button.setAttribute("aria-expanded", String(open));
      button.setAttribute("aria-label", open ? "メニューを閉じる" : "メニューを開く");
      menu.setAttribute("aria-hidden", String(!open));
      menu.hidden = !open;
      header.classList.toggle("is-menu-open", open);
      document.body.classList.toggle("is-menu-open", open);

      if (open) {
        menuLinks[0]?.focus();
      } else if (restoreFocus) {
        button.focus();
      }
    };

    button.addEventListener("click", () => {
      setOpen(button.getAttribute("aria-expanded") !== "true");
    });

    menuLinks.forEach((link) => link.addEventListener("click", () => setOpen(false, true)));

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && button.getAttribute("aria-expanded") === "true") {
        setOpen(false, true);
      }

      if (event.key === "Tab" && button.getAttribute("aria-expanded") === "true") {
        const focusable = [button, ...menuLinks];
        const first = focusable[0];
        const last = focusable[focusable.length - 1];

        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last?.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first?.focus();
        }
      }
    });

    window.addEventListener("resize", () => {
      if (window.innerWidth > 860 && button.getAttribute("aria-expanded") === "true") {
        setOpen(false);
      }
    });

    const updateHeader = () => header.classList.toggle("is-scrolled", window.scrollY > 20);
    window.addEventListener("scroll", updateHeader, { passive: true });
    updateHeader();
  };

  bindHeader();
  document.addEventListener("astro:page-load", bindHeader);
</script>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 100;
    display: grid;
    grid-template-columns: minmax(12rem, 1fr) auto;
    height: var(--header-height);
    color: var(--paper);
    border-bottom: 1px solid var(--line-light);
    background: linear-gradient(180deg, rgb(7 12 9 / 0.7), rgb(7 12 9 / 0));
    transition: background-color 180ms ease, border-color 180ms ease;
  }

  :global(body.is-menu-open) {
    overflow: hidden;
  }

  .site-header.is-scrolled,
  .site-header.is-menu-open {
    border-color: rgb(255 255 255 / 0.14);
    background: rgb(13 20 16 / 0.96);
  }

  .site-brand {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 0.9rem;
    padding-inline: var(--page-pad) 1.5rem;
    color: inherit;
    text-decoration: none;
  }

  .site-brand__mark {
    font-family: var(--font-condensed, "Arial Narrow", Arial, sans-serif);
    font-size: 1.3rem;
    font-weight: 800;
    letter-spacing: -0.06em;
    line-height: 1;
  }

  .site-brand__name {
    padding-left: 0.9rem;
    border-left: 1px solid var(--line-light);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1;
    white-space: nowrap;
  }

  .site-nav {
    display: flex;
    align-items: stretch;
  }

  .site-nav a {
    display: flex;
    min-width: clamp(5rem, 7vw, 7.5rem);
    min-height: 44px;
    align-items: center;
    justify-content: center;
    padding-inline: 1rem;
    color: inherit;
    border-left: 1px solid var(--line-light);
    font: 700 0.66rem/1 var(--font-condensed, "Arial Narrow", Arial, sans-serif);
    letter-spacing: 0.16em;
    text-decoration: none;
    transition: color 160ms ease, background-color 160ms ease;
  }

  .site-nav a:hover,
  .site-nav a:focus-visible {
    color: var(--ink);
    background: var(--paper);
  }

  .site-nav a.is-contact {
    color: var(--ink);
    background: var(--brass);
  }

  .site-nav a.is-contact:hover,
  .site-nav a.is-contact:focus-visible {
    background: var(--paper);
  }

  .site-menu-button,
  .site-menu {
    display: none;
  }

  .site-menu[hidden] {
    display: none;
  }

  @media (max-width: 860px) {
    .site-header {
      grid-template-columns: 1fr auto;
    }

    .site-nav {
      display: none;
    }

    .site-menu-button {
      display: flex;
      min-width: 6.5rem;
      min-height: 44px;
      align-items: center;
      justify-content: space-between;
      gap: 0.8rem;
      padding: 0 1.15rem;
      color: inherit;
      border: 0;
      border-left: 1px solid var(--line-light);
      background: transparent;
      cursor: pointer;
      font: 700 0.64rem/1 var(--font-condensed, "Arial Narrow", Arial, sans-serif);
      letter-spacing: 0.14em;
    }

    .site-menu-button__icon {
      position: relative;
      width: 1.15rem;
      height: 0.8rem;
    }

    .site-menu-button__icon i {
      position: absolute;
      left: 0;
      width: 100%;
      height: 1px;
      background: currentColor;
      transition: top 160ms ease, transform 160ms ease;
    }

    .site-menu-button__icon i:first-child { top: 0.2rem; }
    .site-menu-button__icon i:last-child { top: 0.62rem; }
    .is-menu-open .site-menu-button__icon i:first-child { top: 0.4rem; transform: rotate(45deg); }
    .is-menu-open .site-menu-button__icon i:last-child { top: 0.4rem; transform: rotate(-45deg); }

    .site-menu {
      position: fixed;
      inset: var(--header-height) 0 0;
      display: grid;
      grid-template-rows: 1fr auto;
      padding: clamp(1.5rem, 6vw, 3rem) var(--page-pad) 1.5rem;
      color: var(--paper);
      background: var(--ink);
      overflow-y: auto;
    }

    .site-menu nav {
      display: grid;
      align-content: center;
      width: min(100%, 42rem);
      margin-inline: auto;
      border-top: 1px solid var(--line-light);
    }

    .site-menu nav a {
      display: grid;
      grid-template-columns: 2.5rem 1fr;
      align-items: center;
      min-height: 4.4rem;
      color: inherit;
      border-bottom: 1px solid var(--line-light);
      text-decoration: none;
    }

    .site-menu nav a > span {
      color: var(--brass);
      font: 600 0.62rem/1 var(--font-mono, Consolas, monospace);
    }

    .site-menu nav strong {
      font: 600 clamp(1.4rem, 6vw, 2.3rem)/1 var(--font-condensed, "Arial Narrow", Arial, sans-serif);
      letter-spacing: 0.08em;
    }

    .site-menu > p {
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      margin: 1.5rem 0 0;
      padding-top: 1rem;
      color: rgb(255 255 255 / 0.5);
      border-top: 1px solid var(--line-light);
      font-size: 0.62rem;
      letter-spacing: 0.08em;
    }

    .site-menu > p span,
    .site-menu > p strong {
      font: inherit;
    }
  }

  @media (max-width: 520px) {
    .site-brand {
      gap: 0.7rem;
      padding-left: var(--page-pad);
    }

    .site-brand__name {
      padding-left: 0.7rem;
      font-size: 0.64rem;
    }

    .site-menu-button {
      min-width: 5.7rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header,
    .site-nav a,
    .site-menu-button__icon i {
      transition: none;
    }
  }
</style>
