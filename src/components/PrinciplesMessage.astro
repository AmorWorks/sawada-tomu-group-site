---
import { Image } from "astro:assets";
import presidentPhoto from "../assets/images/president-sawada-tomu.jpg";

const principles = [
  { number: "01", line: "曲がったことはしない", result: "それが仕事に表れる" },
  { number: "02", line: "嘘はつかない", result: "それが人柄を創る" },
  { number: "03", line: "信念を持つ", result: "それが己を強くする" },
  { number: "04", line: "人への感謝を忘れない", result: "それが未来に繋がる" },
  { number: "05", line: "だから今の我々が", result: "生かされ生きている" },
] as const;
---

<section class="principles-message" id="about" aria-labelledby="principles-title">
  <div class="pm-headerline" aria-hidden="true">
    <span>05 / PHILOSOPHY</span>
    <span>MESSAGE</span>
  </div>

  <div class="pm-principles" id="philosophy">
    <header class="pm-principles__heading">
      <p class="pm-kicker">PHILOSOPHY <span>判断基準</span></p>
      <h2 id="principles-title">理念は、<br />現場で使うもの。</h2>
      <p class="pm-intro">迷ったとき、最後に戻るのは難しい言葉ではなく、どう仕事と人に向き合うかです。</p>
    </header>

    <ol class="pm-principle-list" aria-label="STGの経営理念">
      {
        principles.map((principle) => (
          <li>
            <span class="pm-principle-number">{principle.number}</span>
            <p class="pm-principle-copy">
              <strong>{principle.line}</strong>
              <span>{principle.result}</span>
            </p>
          </li>
        ))
      }
    </ol>
  </div>

  <div class="pm-handoff" aria-hidden="true">
    <span>PRINCIPLES</span>
    <i></i>
    <span>REPRESENTATIVE MESSAGE</span>
  </div>

  <div class="pm-message">
    <figure class="pm-photo">
      <Image
        src={presidentPhoto}
        alt="樹木のそばに立つ人物のポートレート"
        widths={[560, 800, 1120]}
        sizes="(max-width: 820px) 100vw, 42vw"
        format="webp"
        quality={84}
        loading="lazy"
      />
      <figcaption>
        <span>MESSAGE</span>
        <span>SAWADA TOMU GROUP</span>
      </figcaption>
    </figure>

    <article class="pm-message__copy" aria-labelledby="message-title">
      <p class="pm-kicker">MESSAGE <span>代表の言葉</span></p>
      <p class="pm-message__label">仕事に、人柄が表れる。</p>
      <h3 id="message-title">一つひとつの現場に、<br />誠実でありたい。</h3>

      <div class="pm-message__body">
        <p>株式会社STGは、伐採・抜根、草刈り、剪定、外構工事など、暮らしの外まわりに関わる仕事に、仲間とともに取り組んでいます。目の前の作業をただ終わらせるのではなく、お客様に「任せてよかった」と思っていただける仕事を積み重ねること。それが私たちの役目です。</p>
        <p>曲がったことはしない。嘘はつかない。信念を持ち、人への感謝を忘れない。この理念は、飾るための言葉ではありません。技術だけでなく、挨拶、報告、片付け、約束を守る姿勢まで含めて仕事であり、その積み重ねが信頼につながると考えています。</p>
        <p>お客様、取引先の皆様、共に働く仲間、そして私たちを支えてくださるすべての方への感謝を忘れず、これからも一つひとつのご縁と現場を大切にします。「あなたを笑顔にする会社」として、仲間とともに、どんな夢も叶えていける会社を目指してまいります。</p>
      </div>

      <footer class="pm-signature">
        <span>株式会社STG</span>
        <strong>代表取締役　澤田 叶夢</strong>
      </footer>
    </article>
  </div>
</section>

<style>
  .principles-message {
    color: var(--ink, #111713);
    background: var(--paper, #f3efe7);
    border-top: 1px solid var(--line, rgb(17 23 19 / 0.14));
    scroll-margin-top: calc(var(--site-header-height, 5rem) + 1rem);
  }

  .pm-headerline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem var(--page-pad, clamp(1.25rem, 4.5vw, 5.5rem));
    color: var(--brass-dark, #725838);
    border-bottom: 1px solid var(--line, rgb(17 23 19 / 0.14));
    font: 700 0.66rem/1 var(--font-condensed, sans-serif);
    letter-spacing: 0.18em;
  }

  .pm-principles {
    display: grid;
    grid-template-columns: minmax(18rem, 0.78fr) minmax(0, 1.22fr);
    gap: clamp(3rem, 8vw, 9rem);
    width: min(100%, 96rem);
    margin-inline: auto;
    padding: clamp(5rem, 10vw, 10rem) var(--page-pad, clamp(1.25rem, 4.5vw, 5.5rem));
    scroll-margin-top: calc(var(--site-header-height, 5rem) + 1rem);
  }

  .pm-kicker {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 0 0 2rem;
    color: var(--brass-dark, #725838);
    font: 700 0.7rem/1.3 var(--font-condensed, sans-serif);
    letter-spacing: 0.18em;
  }

  .pm-kicker span {
    color: var(--muted, #68716b);
    font-family: var(--font-body, sans-serif);
    letter-spacing: 0.08em;
  }

  .pm-principles__heading h2 {
    max-width: 9em;
    margin: 0;
    font-family: var(--font-display, serif);
    font-size: clamp(2.8rem, 6.3vw, 6.8rem);
    font-weight: 500;
    letter-spacing: -0.055em;
    line-height: 1.04;
  }

  .pm-intro {
    max-width: 31rem;
    margin: clamp(2rem, 5vw, 3.5rem) 0 0;
    color: var(--ink-soft, #26332b);
    line-height: 2;
  }

  .pm-principle-list {
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--line, rgb(17 23 19 / 0.14));
    list-style: none;
  }

  .pm-principle-list li {
    display: grid;
    grid-template-columns: 3.2rem minmax(0, 1fr);
    gap: clamp(1rem, 2vw, 2rem);
    align-items: baseline;
    padding-block: clamp(1.7rem, 3vw, 2.6rem);
    border-bottom: 1px solid var(--line, rgb(17 23 19 / 0.14));
  }

  .pm-principle-number {
    color: var(--brass-dark, #725838);
    font: 700 0.68rem/1 var(--font-mono, monospace);
    letter-spacing: 0.12em;
  }

  .pm-principle-copy {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(8rem, 0.52fr);
    gap: clamp(1rem, 3vw, 3rem);
    align-items: baseline;
    margin: 0;
  }

  .pm-principle-copy strong {
    font-family: var(--font-display, serif);
    font-size: clamp(1.4rem, 2.8vw, 2.8rem);
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1.4;
  }

  .pm-principle-copy > span {
    color: var(--ink-soft, #26332b);
    font-size: 0.88rem;
    line-height: 1.7;
  }

  .pm-handoff {
    display: grid;
    grid-template-columns: auto minmax(2rem, 1fr) auto;
    gap: 1.25rem;
    align-items: center;
    width: min(100%, 96rem);
    margin-inline: auto;
    padding: 0 var(--page-pad, clamp(1.25rem, 4.5vw, 5.5rem)) clamp(2rem, 5vw, 4rem);
    color: var(--muted, #68716b);
    font: 700 0.64rem/1 var(--font-condensed, sans-serif);
    letter-spacing: 0.16em;
  }

  .pm-handoff i {
    height: 1px;
    background: var(--line, rgb(17 23 19 / 0.14));
  }

  .pm-message {
    display: grid;
    grid-template-columns: minmax(18rem, 0.84fr) minmax(24rem, 1.16fr);
    gap: clamp(2.5rem, 7vw, 8rem);
    align-items: start;
    width: min(100%, 96rem);
    margin-inline: auto;
    padding: clamp(2rem, 4vw, 4rem) var(--page-pad, clamp(1.25rem, 4.5vw, 5.5rem)) clamp(6rem, 11vw, 11rem);
    border-top: 1px solid var(--line, rgb(17 23 19 / 0.14));
  }

  .pm-photo {
    position: relative;
    aspect-ratio: 4 / 5;
    margin: 0;
    overflow: hidden;
    background: var(--sand, #d9d0c1);
  }

  .pm-photo::after {
    position: absolute;
    inset: 45% 0 0;
    content: "";
    background: linear-gradient(180deg, transparent, rgb(7 11 10 / 0.52));
    pointer-events: none;
  }

  .pm-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
  }

  .pm-photo figcaption {
    position: absolute;
    z-index: 1;
    right: clamp(1rem, 2.2vw, 2rem);
    bottom: clamp(1rem, 2.2vw, 2rem);
    left: clamp(1rem, 2.2vw, 2rem);
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: white;
    font: 700 0.62rem/1.3 var(--font-condensed, sans-serif);
    letter-spacing: 0.14em;
  }

  .pm-message__copy {
    padding-top: clamp(1rem, 3vw, 3rem);
  }

  .pm-message__label {
    margin: 0 0 2rem;
    color: var(--brass-dark, #725838);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.1em;
  }

  .pm-message__copy h3 {
    max-width: 11em;
    margin: 0;
    font-family: var(--font-display, serif);
    font-size: clamp(2.45rem, 5vw, 5.4rem);
    font-weight: 500;
    letter-spacing: -0.05em;
    line-height: 1.1;
  }

  .pm-message__body {
    display: grid;
    gap: 1.55rem;
    max-width: 44rem;
    margin-top: clamp(3rem, 6vw, 5.5rem);
    color: var(--ink-soft, #26332b);
    line-height: 2.15;
  }

  .pm-message__body p {
    margin: 0;
  }

  .pm-signature {
    display: grid;
    gap: 0.45rem;
    margin-top: 3.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--line, rgb(17 23 19 / 0.14));
  }

  .pm-signature span {
    color: var(--ink-soft, #26332b);
    font-size: 0.82rem;
  }

  .pm-signature strong {
    font-size: 1rem;
    letter-spacing: 0.06em;
  }

  @media (max-width: 820px) {
    .pm-principles,
    .pm-message {
      grid-template-columns: 1fr;
    }

    .pm-principles {
      gap: 3.5rem;
      padding-block: 4.5rem 5.5rem;
    }

    .pm-principle-copy {
      grid-template-columns: 1fr;
      gap: 0.45rem;
    }

    .pm-handoff {
      grid-template-columns: auto 1fr;
    }

    .pm-handoff span:last-child {
      grid-column: 1 / -1;
    }

    .pm-message {
      gap: 3rem;
      padding-top: 1.25rem;
      padding-bottom: 6rem;
    }

    .pm-photo {
      aspect-ratio: 4 / 3;
    }

    .pm-message__copy {
      padding-top: 0;
    }
  }

  @media (max-width: 520px) {
    .pm-headerline {
      padding-inline: 1rem;
      font-size: 0.58rem;
    }

    .pm-principles__heading h2,
    .pm-message__copy h3 {
      font-size: clamp(2.35rem, 11vw, 3.4rem);
    }

    .pm-principle-list li {
      grid-template-columns: 2.4rem minmax(0, 1fr);
    }

    .pm-photo figcaption {
      font-size: 0.56rem;
    }
  }
</style>
