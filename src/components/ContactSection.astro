---
const instagramHref = "https://www.instagram.com/sawadatomugroup?igsh=aG04ZGp1NHludTBl";
---

<section class="contact section-shell" id="contact" aria-labelledby="contact-title">
  <div class="contact-index" aria-hidden="true">
    <span>07 / CONTACT</span>
    <span>INSTAGRAM DM</span>
  </div>

  <div class="contact-inner">
    <div class="contact-heading">
      <p>現場のことを、</p>
      <h2 id="contact-title">まず聞かせてください。</h2>
      <p class="contact-lead" id="contact-description">
        ご相談内容と現場の写真があれば、InstagramのDMでお送りください。
      </p>
    </div>

    <a
      class="contact-action"
      href={instagramHref}
      target="_blank"
      rel="noopener noreferrer"
      aria-describedby="contact-description contact-note"
    >
      <span>
        <small>INSTAGRAM</small>
        <strong>DMで相談する</strong>
      </span>
      <span class="contact-action__arrow" aria-hidden="true">↗</span>
    </a>
  </div>

  <p class="contact-note" id="contact-note">Instagramが新しいタブで開きます</p>
</section>

<style>
  .contact {
    position: relative;
    min-height: min(82svh, 58rem);
    color: var(--paper);
    background:
      linear-gradient(90deg, transparent calc(50% - 0.5px), rgb(255 255 255 / 0.08) 50%, transparent calc(50% + 0.5px)),
      var(--green);
  }

  .contact-index {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem var(--page-pad);
    color: rgb(255 255 255 / 0.58);
    border-bottom: 1px solid var(--line-light);
    font: 700 0.64rem/1 var(--font-condensed, "Arial Narrow", Arial, sans-serif);
    letter-spacing: 0.16em;
  }

  .contact-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(19rem, 0.7fr);
    gap: clamp(3rem, 9vw, 10rem);
    align-items: end;
    min-height: calc(min(82svh, 58rem) - 7rem);
    padding: clamp(4rem, 9vw, 8rem) var(--page-pad) clamp(3rem, 7vw, 6rem);
  }

  .contact-heading > p:first-child {
    margin: 0 0 0.35em;
    color: var(--brass-light, var(--brass));
    font-family: var(--font-display, "Yu Mincho", YuMincho, serif);
    font-size: clamp(1.5rem, 3.5vw, 3.8rem);
    line-height: 1.2;
  }

  .contact-heading h2 {
    max-width: 9ch;
    margin: 0;
    font-family: var(--font-display, "Yu Mincho", YuMincho, serif);
    font-size: clamp(3.4rem, 8.2vw, 9rem);
    font-weight: 500;
    letter-spacing: -0.065em;
    line-height: 0.98;
  }

  .contact-lead {
    max-width: 36rem;
    margin: clamp(2rem, 5vw, 4rem) 0 0;
    color: rgb(255 255 255 / 0.72);
    font-size: clamp(0.9rem, 1.1vw, 1.05rem);
    line-height: 2;
  }

  .contact-action {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 9rem;
    padding: 1.5rem 0;
    color: var(--paper);
    border-top: 1px solid var(--paper);
    border-bottom: 1px solid var(--paper);
    text-decoration: none;
    transition: color 180ms ease, padding 220ms ease;
  }

  .contact-action:hover,
  .contact-action:focus-visible {
    padding-inline: 0.75rem;
    color: var(--brass-light, var(--brass));
  }

  .contact-action > span:first-child {
    display: grid;
    gap: 0.85rem;
  }

  .contact-action small {
    color: currentColor;
    font: 700 0.65rem/1 var(--font-condensed, "Arial Narrow", Arial, sans-serif);
    letter-spacing: 0.18em;
  }

  .contact-action strong {
    font-size: clamp(1.35rem, 2.6vw, 2.5rem);
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .contact-action__arrow {
    flex: none;
    font: 400 clamp(2.2rem, 5vw, 4.5rem)/1 var(--font-condensed, "Arial Narrow", Arial, sans-serif);
  }

  .contact-note {
    margin: 0;
    padding: 1rem var(--page-pad);
    color: rgb(255 255 255 / 0.5);
    border-top: 1px solid var(--line-light);
    font-size: 0.68rem;
    letter-spacing: 0.05em;
    text-align: right;
  }

  @media (max-width: 760px) {
    .contact {
      min-height: 0;
      background: var(--green);
    }

    .contact-inner {
      grid-template-columns: 1fr;
      gap: 3.5rem;
      min-height: 0;
      padding-block: clamp(4rem, 18vw, 7rem) 3.5rem;
    }

    .contact-heading h2 {
      max-width: 8ch;
      font-size: clamp(3rem, 15vw, 5.2rem);
    }

    .contact-lead {
      line-height: 1.9;
    }

    .contact-action {
      min-height: 7.5rem;
    }

    .contact-note {
      text-align: left;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-action {
      transition: none;
    }
  }
</style>
