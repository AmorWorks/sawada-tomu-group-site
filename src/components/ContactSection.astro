---
const phoneDisplay = "080-8490-7800";
const phoneHref = "tel:08084907800";
const lineHref = "https://line.me/ti/p/bPoUZU_uZ-";
const instagramHref = "https://www.instagram.com/sawadatomugroup?igsh=aG04ZGp1NHludTBl";

const routes = [
  { number: "01", label: "法人・管理会社", copy: "継続管理や複数箇所のご相談も、まずは現場の状況からお聞かせください。" },
  { number: "02", label: "伐採・剪定・外構", copy: "作業を希望する場所の写真があると、相談がスムーズです。" },
  { number: "03", label: "採用について", copy: "仕事内容や働き方について、応募前のご質問も受け付けています。" }
];
---

<!-- Phone and SNS destinations must be re-confirmed immediately before public release. -->
<section class="contact section-shell" id="contact" aria-labelledby="contact-title">
  <div class="contact-backdrop" aria-hidden="true">STG</div>
  <div class="section-kicker" data-reveal>
    <span>CONTACT</span>
    <span>ご相談</span>
  </div>

  <div class="contact-grid">
    <div class="contact-heading" data-reveal>
      <p>THE NEXT MOVE</p>
      <h2 id="contact-title">現場のことを、<br />まず聞かせてください。</h2>
      <p class="contact-lead">現場写真がある場合はLINEまたはInstagramのDMが便利です。お急ぎの場合は電話でご相談ください。</p>
    </div>

    <div class="contact-actions" data-reveal>
      <a class="contact-primary" href={lineHref} target="_blank" rel="noopener">
        <span>LINEで現場写真を送る</span>
        <span aria-hidden="true">↗</span>
      </a>
      <a href={phoneHref}>
        <span>電話で相談</span>
        <strong>{phoneDisplay}</strong>
      </a>
      <a href={instagramHref} target="_blank" rel="noopener">
        <span>Instagram</span>
        <strong>DMで相談する</strong>
      </a>
    </div>
  </div>

  <div class="contact-routes" data-reveal>
    {routes.map((route) => (
      <article>
        <span>{route.number}</span>
        <h3>{route.label}</h3>
        <p>{route.copy}</p>
      </article>
    ))}
  </div>
</section>

<style>
  .contact {
    position: relative;
    overflow: hidden;
    background: var(--green);
    color: white;
  }

  .contact-backdrop {
    position: absolute;
    right: -0.08em;
    bottom: -0.26em;
    color: rgb(255 255 255 / 0.045);
    font: 700 min(48vw, 44rem)/0.8 var(--font-condensed);
    letter-spacing: -0.08em;
    pointer-events: none;
  }

  .contact-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(20rem, 0.7fr);
    gap: clamp(3rem, 8vw, 10rem);
    padding: clamp(4rem, 10vw, 10rem) var(--page-pad) clamp(3rem, 7vw, 7rem);
  }

  .contact-heading > p:first-child {
    margin: 0 0 2.5rem;
    color: var(--brass-light);
    font: 600 0.72rem/1 var(--font-condensed);
    letter-spacing: 0.18em;
  }

  .contact-heading h2 {
    margin: 0;
    max-width: 12ch;
    font-size: clamp(3rem, 7vw, 8rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.055em;
  }

  .contact-lead {
    max-width: 39rem;
    margin: clamp(2rem, 5vw, 4rem) 0 0;
    color: rgb(255 255 255 / 0.72);
    line-height: 2;
  }

  .contact-actions {
    align-self: end;
    display: grid;
    border-top: 1px solid rgb(255 255 255 / 0.2);
  }

  .contact-actions a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 5.5rem;
    padding: 1rem 0;
    border-bottom: 1px solid rgb(255 255 255 / 0.2);
    color: white;
    text-decoration: none;
    transition: padding 220ms var(--ease-out), color 220ms ease;
  }

  .contact-actions a:hover,
  .contact-actions a:focus-visible {
    padding-right: 0.6rem;
    padding-left: 0.6rem;
    color: var(--brass-light);
  }

  .contact-actions span,
  .contact-actions strong {
    font-size: 0.92rem;
  }

  .contact-actions strong {
    letter-spacing: 0.03em;
  }

  .contact-actions .contact-primary {
    min-height: 7rem;
    color: var(--ink);
    background: var(--paper);
    padding-inline: 1.4rem;
    border-bottom: 0;
  }

  .contact-actions .contact-primary:hover,
  .contact-actions .contact-primary:focus-visible {
    padding-inline: 1.8rem;
    color: var(--green);
  }

  .contact-routes {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid rgb(255 255 255 / 0.2);
  }

  .contact-routes article {
    min-height: 15rem;
    padding: 2rem var(--page-pad) 3rem;
    border-right: 1px solid rgb(255 255 255 / 0.2);
  }

  .contact-routes article:last-child {
    border-right: 0;
  }

  .contact-routes article > span {
    color: var(--brass-light);
    font: 600 0.7rem/1 var(--font-condensed);
  }

  .contact-routes h3 {
    margin: 3rem 0 1rem;
    font-size: clamp(1.2rem, 2vw, 1.8rem);
  }

  .contact-routes p {
    margin: 0;
    max-width: 24rem;
    color: rgb(255 255 255 / 0.68);
    line-height: 1.8;
  }

  @media (max-width: 820px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }

    .contact-routes {
      grid-template-columns: 1fr;
    }

    .contact-routes article {
      min-height: 0;
      padding-block: 2.25rem;
      border-right: 0;
      border-bottom: 1px solid rgb(255 255 255 / 0.2);
    }

    .contact-routes article:last-child {
      border-bottom: 0;
    }

    .contact-routes h3 {
      margin-top: 1.5rem;
    }
  }
</style>
