---
const home = import.meta.env.BASE_URL;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <p class="site-footer__brand">株式会社STG</p>
  <small>© {year} STG</small>
  <a href={`${home}#top`}>BACK TO TOP <span aria-hidden="true">↑</span></a>
</footer>

<style>
  .site-footer {
    display: grid;
    grid-template-columns: 1fr auto auto;
    align-items: center;
    gap: clamp(1rem, 4vw, 3rem);
    min-height: 4.5rem;
    padding: 1rem var(--page-pad);
    color: rgb(255 255 255 / 0.56);
    border-top: 1px solid var(--line-light);
    background: var(--ink);
    font: 600 0.62rem/1.4 var(--font-condensed, "Arial Narrow", Arial, sans-serif);
    letter-spacing: 0.1em;
  }

  .site-footer__brand,
  .site-footer small {
    margin: 0;
    font: inherit;
  }

  .site-footer__brand {
    color: var(--paper);
    letter-spacing: 0.08em;
  }

  .site-footer a {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: inherit;
    text-decoration: none;
    transition: color 160ms ease;
  }

  .site-footer a:hover,
  .site-footer a:focus-visible {
    color: var(--paper);
  }

  @media (max-width: 560px) {
    .site-footer {
      grid-template-columns: 1fr auto;
      gap: 0.5rem 1rem;
      padding-block: 1.15rem;
    }

    .site-footer small {
      grid-column: 1 / -1;
      grid-row: 2;
    }

    .site-footer a {
      grid-column: 2;
      grid-row: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-footer a {
      transition: none;
    }
  }
</style>
