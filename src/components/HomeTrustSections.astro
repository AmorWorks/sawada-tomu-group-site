---
import {
  audiencePaths,
  faqs,
  processSteps,
  services,
  trustSignals,
} from "../data/site";
---

<div class="trust-sections">
  <section class="trust-band" id="trust" aria-labelledby="trust-band-title">
    <div class="trust-container">
      <header class="trust-heading trust-heading--light">
        <p class="trust-kicker">WHAT WE DO</p>
        <h2 id="trust-band-title">仕事の輪郭を、曖昧にしない。</h2>
        <p class="trust-intro">
          できることを正しく伝え、現場の状態を確かめるところから始める。<br />
          STGが向き合う仕事を、3つの領域でご案内します。
        </p>
      </header>

      <div class="trust-signal-grid">
        {
          trustSignals.map((signal, index) => (
            <article class="trust-signal">
              <div class="trust-signal-meta">
                <span aria-hidden="true">0{index + 1}</span>
                <p>{signal.label}</p>
              </div>
              <h3>{signal.title}</h3>
              <p class="trust-signal-copy">{signal.detail}</p>
            </article>
          ))
        }
      </div>

      <a class="trust-inline-link trust-inline-link--light" href="#services">
        6つの業務を確認する
        <span aria-hidden="true">↘</span>
      </a>
    </div>
  </section>

  <section class="trust-section trust-audiences" id="audiences" aria-labelledby="audiences-title">
    <div class="trust-container">
      <header class="trust-heading">
        <p class="trust-kicker">CHOOSE YOUR PATH</p>
        <h2 id="audiences-title">ここから、あなたに必要な情報へ。</h2>
        <p class="trust-intro">
          ご依頼、現場のお困りごと、採用。それぞれの目的に合う入口を選べます。
        </p>
      </header>

      <div class="trust-audience-grid">
        {
          audiencePaths.map((path, index) => (
            <a class="trust-audience-card" href={path.href}>
              <div class="trust-card-topline">
                <span>0{index + 1}</span>
                <p>{path.label}</p>
              </div>
              <h3>{path.title}</h3>
              <p class="trust-card-copy">{path.description}</p>
              <span class="trust-card-cta">
                {path.cta}
                <span aria-hidden="true">→</span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="trust-section trust-services" id="services" aria-labelledby="services-title">
    <div class="trust-container">
      <div class="trust-section-split">
        <header class="trust-heading trust-heading--sticky">
          <p class="trust-kicker">SERVICES</p>
          <h2 id="services-title">現場に合わせて、必要な仕事を。</h2>
          <p class="trust-intro">
            樹木、緑地、外まわり、足場。まずは該当する業務をご確認ください。
          </p>
          <a class="trust-inline-link" href="#contact">
            仕事内容を相談する
            <span aria-hidden="true">↘</span>
          </a>
        </header>

        <div class="trust-service-list">
          {
            services.map((service) => (
              <article class="trust-service" id={`service-${service.slug}`}>
                <span class="trust-service-number" aria-hidden="true">{service.number}</span>
                <div>
                  <h3>{service.title}</h3>
                  <p>{service.description}</p>
                  <a href="#contact">
                    この仕事について相談する
                    <span aria-hidden="true">→</span>
                  </a>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <slot name="after-services" />

  <section class="trust-section trust-process" id="process" aria-labelledby="process-title">
    <div class="trust-container">
      <div class="trust-section-split">
        <header class="trust-heading trust-heading--sticky">
          <p class="trust-kicker">PROCESS</p>
          <h2 id="process-title">相談してから、仕事が終わるまで。</h2>
          <p class="trust-intro">
            何を伝えればよいか、次に何があるか。最初に流れを知っておくことで、相談の不安を減らします。
          </p>
        </header>

        <ol class="trust-process-list">
          {
            processSteps.map((step) => (
              <li>
                <span class="trust-process-number">STEP {step.number}</span>
                <div>
                  <h3>{step.title}</h3>
                  <p>{step.description}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <slot name="before-faq" />

  <section class="trust-section trust-faq" id="faq" aria-labelledby="faq-title">
    <div class="trust-container">
      <header class="trust-heading trust-heading--center">
        <p class="trust-kicker">FAQ</p>
        <h2 id="faq-title">相談前によくあるご質問。</h2>
        <p class="trust-intro">
          決まっていないことがあっても大丈夫です。まず確認したい点をまとめました。
        </p>
      </header>

      <div class="trust-faq-list">
        {
          faqs.map((faq, index) => (
            <details class="trust-faq-item">
              <summary>
                <span class="trust-faq-number">Q.{String(index + 1).padStart(2, "0")}</span>
                <span class="trust-faq-question">{faq.question}</span>
                <span class="trust-faq-icon" aria-hidden="true" />
              </summary>
              <div class="trust-faq-answer">
                <p>{faq.answer}</p>
              </div>
            </details>
          ))
        }
      </div>

      <aside class="trust-contact-bridge" aria-label="お問い合わせへのご案内">
        <div>
          <p class="trust-kicker">CONTACT</p>
          <h3>現場について、分かる範囲から。</h3>
          <p>
            ご希望の業務、現場の場所や状態、写真の有無を添えていただくと確認が進めやすくなります。
          </p>
        </div>
        <a href="#contact">
          お問い合わせへ
          <span aria-hidden="true">→</span>
        </a>
      </aside>
    </div>
  </section>
</div>

<style>
  .trust-sections {
    --trust-ink: var(--ink, #141310);
    --trust-paper: var(--paper, #f4f0e8);
    --trust-surface: var(--surface, #fbf9f5);
    --trust-accent: var(--accent, #b88a52);
    --trust-muted: var(--muted, #68635b);
    --trust-line: var(--line, rgba(20, 19, 16, 0.16));
    --trust-light-line: rgba(255, 255, 255, 0.18);
    color: var(--trust-ink);
    background: var(--trust-paper);
    font-family: var(--font-body, "Noto Sans JP", sans-serif);
  }

  .trust-container {
    width: min(100% - 2rem, 76rem);
    margin-inline: auto;
  }

  .trust-section,
  .trust-band {
    scroll-margin-top: 6rem;
  }

  .trust-section {
    padding-block: clamp(5rem, 9vw, 9rem);
  }

  .trust-band {
    position: relative;
    overflow: hidden;
    padding-block: clamp(4.5rem, 8vw, 8rem);
    color: var(--trust-paper);
    background:
      radial-gradient(circle at 88% 12%, rgba(184, 138, 82, 0.16), transparent 30rem),
      var(--trust-ink);
  }

  .trust-band::before {
    position: absolute;
    inset: 0;
    pointer-events: none;
    content: "";
    background-image: linear-gradient(var(--trust-light-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--trust-light-line) 1px, transparent 1px);
    background-size: 7rem 7rem;
    mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.32), transparent 72%);
    opacity: 0.18;
  }

  .trust-band .trust-container {
    position: relative;
  }

  .trust-heading {
    max-width: 46rem;
  }

  .trust-heading--center {
    margin-inline: auto;
    text-align: center;
  }

  .trust-heading--light {
    color: var(--trust-paper);
  }

  .trust-kicker {
    margin: 0 0 1.2rem;
    color: var(--trust-accent);
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.19em;
    line-height: 1.4;
  }

  .trust-heading h2 {
    max-width: 13em;
    margin: 0;
    font-family: var(--font-display, "Noto Serif JP", serif);
    font-size: clamp(2.25rem, 5.2vw, 5.4rem);
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 1.12;
    text-wrap: balance;
  }

  .trust-heading--center h2 {
    margin-inline: auto;
  }

  .trust-intro {
    margin: 1.75rem 0 0;
    color: var(--trust-muted);
    font-size: clamp(0.96rem, 1.4vw, 1.08rem);
    line-height: 2;
  }

  .trust-heading--light .trust-intro {
    color: rgba(244, 240, 232, 0.7);
  }

  .trust-signal-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin-top: clamp(3rem, 6vw, 5.5rem);
    border-block: 1px solid var(--trust-light-line);
  }

  .trust-signal {
    min-height: 18rem;
    padding: 2rem clamp(1.3rem, 2.6vw, 2.5rem) 2.4rem;
    border-right: 1px solid var(--trust-light-line);
  }

  .trust-signal:last-child {
    border-right: 0;
  }

  .trust-signal-meta,
  .trust-card-topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.67rem;
    font-weight: 700;
    letter-spacing: 0.13em;
  }

  .trust-signal-meta {
    color: rgba(244, 240, 232, 0.55);
  }

  .trust-signal-meta p,
  .trust-card-topline p {
    margin: 0;
  }

  .trust-signal h3 {
    max-width: 10em;
    margin: clamp(3.5rem, 7vw, 6.5rem) 0 1rem;
    font-family: var(--font-display, "Noto Serif JP", serif);
    font-size: clamp(1.35rem, 2vw, 2rem);
    font-weight: 500;
    line-height: 1.45;
  }

  .trust-signal-copy {
    margin: 0;
    color: rgba(244, 240, 232, 0.68);
    font-size: 0.9rem;
    line-height: 1.9;
  }

  .trust-inline-link {
    display: inline-flex;
    align-items: center;
    gap: 1.5rem;
    margin-top: 2.2rem;
    padding-block: 0.5rem;
    color: var(--trust-ink);
    border-bottom: 1px solid currentColor;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-decoration: none;
  }

  .trust-inline-link--light {
    color: var(--trust-paper);
  }

  .trust-inline-link span {
    transition: transform 180ms ease;
  }

  .trust-inline-link:hover span,
  .trust-inline-link:focus-visible span {
    transform: translate(0.2rem, 0.2rem);
  }

  .trust-audiences {
    background: var(--trust-paper);
  }

  .trust-audience-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    margin-top: clamp(3rem, 6vw, 5rem);
    background: var(--trust-line);
    border: 1px solid var(--trust-line);
  }

  .trust-audience-card {
    display: flex;
    min-height: 26rem;
    padding: clamp(1.5rem, 3vw, 2.6rem);
    color: var(--trust-ink);
    background: var(--trust-surface);
    flex-direction: column;
    text-decoration: none;
    transition: background-color 220ms ease, color 220ms ease;
  }

  .trust-card-topline {
    color: var(--trust-muted);
  }

  .trust-audience-card h3 {
    max-width: 11em;
    margin: auto 0 1.25rem;
    font-family: var(--font-display, "Noto Serif JP", serif);
    font-size: clamp(1.45rem, 2.5vw, 2.2rem);
    font-weight: 500;
    line-height: 1.5;
  }

  .trust-card-copy {
    margin: 0;
    color: var(--trust-muted);
    font-size: 0.9rem;
    line-height: 1.9;
  }

  .trust-card-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--trust-line);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.06em;
  }

  .trust-audience-card:hover,
  .trust-audience-card:focus-visible {
    color: var(--trust-paper);
    background: var(--trust-ink);
  }

  .trust-audience-card:hover .trust-card-topline,
  .trust-audience-card:focus-visible .trust-card-topline,
  .trust-audience-card:hover .trust-card-copy,
  .trust-audience-card:focus-visible .trust-card-copy {
    color: rgba(244, 240, 232, 0.7);
  }

  .trust-audience-card:hover .trust-card-cta,
  .trust-audience-card:focus-visible .trust-card-cta {
    border-color: var(--trust-light-line);
  }

  .trust-services {
    background: var(--trust-surface);
  }

  .trust-section-split {
    display: grid;
    grid-template-columns: minmax(16rem, 0.85fr) minmax(0, 1.35fr);
    gap: clamp(3rem, 8vw, 8rem);
    align-items: start;
  }

  .trust-heading--sticky {
    position: sticky;
    top: 7rem;
  }

  .trust-service-list {
    border-top: 1px solid var(--trust-line);
  }

  .trust-service {
    display: grid;
    grid-template-columns: 4rem 1fr;
    gap: clamp(1rem, 3vw, 2.5rem);
    padding-block: clamp(2rem, 4vw, 3.2rem);
    border-bottom: 1px solid var(--trust-line);
    scroll-margin-top: 6rem;
  }

  .trust-service-number,
  .trust-process-number,
  .trust-faq-number {
    color: var(--trust-accent);
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.13em;
  }

  .trust-service h3,
  .trust-process-list h3 {
    margin: 0;
    font-family: var(--font-display, "Noto Serif JP", serif);
    font-size: clamp(1.55rem, 2.6vw, 2.5rem);
    font-weight: 500;
    line-height: 1.35;
  }

  .trust-service p,
  .trust-process-list p {
    max-width: 38rem;
    margin: 1rem 0 0;
    color: var(--trust-muted);
    font-size: 0.92rem;
    line-height: 1.95;
  }

  .trust-service a {
    display: inline-flex;
    align-items: center;
    gap: 1.2rem;
    margin-top: 1.4rem;
    color: var(--trust-ink);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-decoration: none;
  }

  .trust-service a span {
    transition: transform 180ms ease;
  }

  .trust-service a:hover span,
  .trust-service a:focus-visible span {
    transform: translateX(0.25rem);
  }

  .trust-process {
    color: var(--trust-paper);
    background: var(--trust-ink);
  }

  .trust-process .trust-intro,
  .trust-process-list p {
    color: rgba(244, 240, 232, 0.67);
  }

  .trust-process-list {
    padding: 0;
    margin: 0;
    list-style: none;
    counter-reset: process;
    border-top: 1px solid var(--trust-light-line);
  }

  .trust-process-list li {
    display: grid;
    grid-template-columns: 6rem 1fr;
    gap: 1.25rem;
    padding-block: clamp(2rem, 4vw, 3.2rem);
    border-bottom: 1px solid var(--trust-light-line);
  }

  .trust-process-number {
    padding-top: 0.6rem;
  }

  .trust-faq {
    background: var(--trust-paper);
  }

  .trust-faq-list {
    max-width: 62rem;
    margin: clamp(3rem, 6vw, 5rem) auto 0;
    border-top: 1px solid var(--trust-line);
  }

  .trust-faq-item {
    border-bottom: 1px solid var(--trust-line);
  }

  .trust-faq-item summary {
    display: grid;
    grid-template-columns: 4rem 1fr 2rem;
    gap: 1rem;
    align-items: center;
    padding-block: clamp(1.35rem, 3vw, 2rem);
    cursor: pointer;
    list-style: none;
  }

  .trust-faq-item summary::-webkit-details-marker {
    display: none;
  }

  .trust-faq-question {
    font-family: var(--font-display, "Noto Serif JP", serif);
    font-size: clamp(1rem, 2vw, 1.3rem);
    font-weight: 500;
    line-height: 1.65;
  }

  .trust-faq-icon {
    position: relative;
    width: 1rem;
    height: 1rem;
    justify-self: end;
  }

  .trust-faq-icon::before,
  .trust-faq-icon::after {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 100%;
    height: 1px;
    content: "";
    background: currentColor;
    transform: translate(-50%, -50%);
    transition: transform 180ms ease;
  }

  .trust-faq-icon::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  .trust-faq-item[open] .trust-faq-icon::after {
    transform: translate(-50%, -50%) rotate(0deg);
  }

  .trust-faq-answer {
    padding: 0 3rem 2rem 5rem;
  }

  .trust-faq-answer p {
    max-width: 48rem;
    margin: 0;
    color: var(--trust-muted);
    font-size: 0.93rem;
    line-height: 2;
  }

  .trust-contact-bridge {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2rem;
    align-items: end;
    max-width: 62rem;
    margin: clamp(3.5rem, 7vw, 6rem) auto 0;
    padding: clamp(2rem, 5vw, 4rem);
    color: var(--trust-paper);
    background: var(--trust-ink);
  }

  .trust-contact-bridge h3 {
    max-width: 15em;
    margin: 0;
    font-family: var(--font-display, "Noto Serif JP", serif);
    font-size: clamp(1.65rem, 3.4vw, 3rem);
    font-weight: 500;
    line-height: 1.4;
  }

  .trust-contact-bridge p:not(.trust-kicker) {
    max-width: 38rem;
    margin: 1rem 0 0;
    color: rgba(244, 240, 232, 0.67);
    font-size: 0.9rem;
    line-height: 1.9;
  }

  .trust-contact-bridge > a {
    display: inline-flex;
    min-width: 12rem;
    min-height: 3.8rem;
    padding: 0.8rem 1.2rem;
    color: var(--trust-ink);
    background: var(--trust-paper);
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-decoration: none;
  }

  .trust-contact-bridge > a span {
    transition: transform 180ms ease;
  }

  .trust-contact-bridge > a:hover span,
  .trust-contact-bridge > a:focus-visible span {
    transform: translateX(0.25rem);
  }

  .trust-audience-card:focus-visible,
  .trust-inline-link:focus-visible,
  .trust-service a:focus-visible,
  .trust-contact-bridge > a:focus-visible,
  .trust-faq-item summary:focus-visible {
    outline: 2px solid var(--trust-accent);
    outline-offset: 4px;
  }

  @media (max-width: 58rem) {
    .trust-signal-grid,
    .trust-audience-grid {
      grid-template-columns: 1fr;
    }

    .trust-signal {
      min-height: 0;
      border-right: 0;
      border-bottom: 1px solid var(--trust-light-line);
    }

    .trust-signal:last-child {
      border-bottom: 0;
    }

    .trust-signal h3 {
      margin-top: 3rem;
    }

    .trust-audience-card {
      min-height: 22rem;
    }

    .trust-section-split {
      grid-template-columns: 1fr;
      gap: 3.5rem;
    }

    .trust-heading--sticky {
      position: static;
    }

    .trust-contact-bridge {
      grid-template-columns: 1fr;
      align-items: start;
    }

    .trust-contact-bridge > a {
      width: min(100%, 18rem);
    }
  }

  @media (max-width: 36rem) {
    .trust-container {
      width: min(100% - 1.25rem, 76rem);
    }

    .trust-heading h2 {
      font-size: clamp(2rem, 11vw, 3rem);
    }

    .trust-intro br {
      display: none;
    }

    .trust-service {
      grid-template-columns: 2.8rem 1fr;
    }

    .trust-process-list li {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }

    .trust-process-number {
      padding-top: 0;
    }

    .trust-faq-item summary {
      grid-template-columns: 3rem 1fr 1.25rem;
      gap: 0.55rem;
    }

    .trust-faq-answer {
      padding: 0 0 1.6rem 3.55rem;
    }

    .trust-contact-bridge {
      padding: 1.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .trust-audience-card,
    .trust-inline-link span,
    .trust-service a span,
    .trust-contact-bridge > a span,
    .trust-faq-icon::before,
    .trust-faq-icon::after {
      transition: none;
    }
  }
</style>
