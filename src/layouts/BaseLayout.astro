---
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  robots?: string;
  canonicalPath?: string;
  redirectTo?: string;
}

const {
  title,
  description,
  ogImage,
  robots = "index,follow,max-image-preview:large",
  canonicalPath,
  redirectTo
} = Astro.props;

const siteBase = Astro.site ?? Astro.url;
const basePath = import.meta.env.BASE_URL === "/"
  ? "/"
  : `${import.meta.env.BASE_URL.replace(/\/+$/, "")}/`;
const canonical = new URL(canonicalPath ?? Astro.url.pathname, siteBase);
const canonicalWithoutIndex = canonical.pathname.replace(/\/index\.html$/, "/");

canonical.pathname = canonicalWithoutIndex.endsWith("/")
  ? canonicalWithoutIndex
  : `${canonicalWithoutIndex}/`;
canonical.search = "";
canonical.hash = "";

const imageUrl = ogImage ? new URL(ogImage, siteBase) : undefined;
const favicon = `${basePath}favicon.svg`;
const organizationUrl = new URL(basePath, siteBase);
const organization = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "株式会社STG",
  alternateName: "SAWADA TOMU GROUP",
  url: organizationUrl.href,
  slogan: "あなたを笑顔にする会社"
};
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#111713" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="generator" content={Astro.generator} />
    {redirectTo && <meta http-equiv="refresh" content={`0; url=${redirectTo}`} />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={favicon} type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:site_name" content="株式会社STG" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    <meta name="twitter:card" content={imageUrl ? "summary_large_image" : "summary"} />
    <title>{title}</title>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(organization)}></script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">本文へ移動</a>
    <SiteHeader />
    <main id="main-content">
      <slot />
    </main>
    <SiteFooter />
    <script src="../scripts/experience.ts"></script>
  </body>
</html>
