---
import teamImage from "../assets/images/hero-stg-team.jpg";
import ContactSection from "../components/ContactSection.astro";
import EntryHero from "../components/EntryHero.astro";
import FaqSection from "../components/FaqSection.astro";
import PrinciplesMessage from "../components/PrinciplesMessage.astro";
import ServiceField from "../components/ServiceField.astro";
import TeamManifesto from "../components/TeamManifesto.astro";
import WorkJourney from "../components/WorkJourney.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "株式会社STG｜あなたを笑顔にする会社";
const description =
  "伐採・抜根、草刈り・年間管理、剪定、外構工事、足場仮設、防草シート施工。株式会社STGは現場と人に誠実に向き合います。";
---

<BaseLayout title={title} description={description} ogImage={teamImage.src}>
  <EntryHero />
  <ServiceField />
  <WorkJourney />
  <TeamManifesto />
  <PrinciplesMessage />
  <FaqSection />
  <ContactSection />
</BaseLayout>
